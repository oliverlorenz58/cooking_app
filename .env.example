# Vorlage für den Server: kopieren nach .env und Werte anpassen
#   cp .env.example .env
# Passwort nur aus Buchstaben/Zahlen, da es in der DATABASE_URL landet
# (z. B. erzeugen mit: openssl rand -hex 24)

POSTGRES_USER=chef
POSTGRES_PASSWORD=bitte_aendern
POSTGRES_DB=recipe_db

# Port, unter dem das Backend auf dem Server erreichbar ist
BACKEND_PORT=3000
